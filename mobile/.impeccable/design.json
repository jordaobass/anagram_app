  "components": [
    {
      "name": "Botão Primário",
      "kind": "button",
      "refersTo": "botao-primario",
      "description": "Ação principal: salvar no slot, conectar, bloco ligado.",
      "html": "<button class=\"ds-btn-primario\">SALVAR NO SLOT</button>",
      "css": ".ds-btn-primario{background:#F0B429;color:#1A1405;border:none;border-radius:6px;min-height:48px;padding:0 16px;font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:17px;letter-spacing:.8px;text-transform:uppercase;cursor:pointer;transition:filter .15s}.ds-btn-primario:hover{filter:brightness(1.08)}.ds-btn-primario:focus-visible{outline:2px solid #F0B429;outline-offset:2px;box-shadow:0 0 0 6px rgba(240,180,41,.24)}"
    },
    {
      "name": "Botão Contorno",
      "kind": "button",
      "refersTo": "botao-contorno",
      "description": "Ação secundária ou destrutiva isolada: descartar, largar, desligado.",
      "html": "<button class=\"ds-btn-contorno\">DESCARTAR</button>",
      "css": ".ds-btn-contorno{background:transparent;color:#EDEDEB;border:1px solid #8E949B;border-radius:6px;min-height:48px;padding:0 16px;font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:17px;letter-spacing:.8px;text-transform:uppercase;cursor:pointer;transition:background .15s}.ds-btn-contorno:hover{background:#24262A}.ds-btn-contorno:focus-visible{outline:2px solid #F0B429;outline-offset:2px}"
    },
    {
      "name": "Cenas",
      "kind": "chip",
      "refersTo": "botao-cena",
      "description": "Três cenas de largura igual; a ativa é preenchida em âmbar.",
      "html": "<div class=\"ds-cenas\"><button class=\"ds-cena\"><b>1</b>VERSO</button><button class=\"ds-cena ds-cena-ativa\"><b>2</b>REFRÃO</button><button class=\"ds-cena\"><b>3</b>SOLO</button></div>",
      "css": ".ds-cenas{display:flex;gap:8px;background:#131416;padding:8px}.ds-cena{flex:1;display:flex;align-items:center;gap:8px;min-height:56px;padding:4px 12px;background:#24262A;color:#EDEDEB;border:1px solid #34373C;border-radius:6px;font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:17px;letter-spacing:.8px;text-transform:uppercase;cursor:pointer;text-align:left}.ds-cena b{font-family:'Saira Stencil One',sans-serif;font-size:20px;font-weight:400}.ds-cena:hover{border-color:#8E949B}.ds-cena:focus-visible{outline:2px solid #F0B429;outline-offset:2px}.ds-cena-ativa{background:#F0B429;color:#1A1405;border-color:#F0B429}"
    },
    {
      "name": "Fita do Preset",
      "kind": "custom",
      "refersTo": "fita-preset",
      "description": "Assinatura: slot em estêncil, nome a marcador na fita gaffer e selo NÃO SALVO.",
      "html": "<div class=\"ds-faixa\"><span class=\"ds-slot\">02A</span><div class=\"ds-fita\"><span class=\"ds-nome\">Sujo de Ensaio</span><span class=\"ds-selo\">NÃO SALVO</span></div></div>",
      "css": ".ds-faixa{display:flex;align-items:center;gap:12px;background:#131416;padding:16px}.ds-slot{font-family:'Saira Stencil One',sans-serif;font-size:40px;line-height:1;color:#EDEDEB}.ds-fita{flex:1;display:flex;align-items:center;gap:8px;min-height:56px;padding:8px 16px;background:#E8E1CD;border-bottom:2px solid #CFC6AE}.ds-nome{flex:1;font-family:'Permanent Marker',cursive;font-size:26px;line-height:1.1;color:#17171A}.ds-selo{background:#C2361F;color:#fff;padding:2px 8px;font-family:'Barlow Condensed',sans-serif;font-weight:600;font-size:14px;letter-spacing:.7px}"
    },
    {
      "name": "Moldura de Case",
      "kind": "card",
      "refersTo": "moldura-case",
      "description": "Painel com filete de 1px e cantoneiras de alumínio nas quinas.",
      "html": "<div class=\"ds-moldura\"><i class=\"a\"></i><i class=\"b\"></i><i class=\"c\"></i><i class=\"d\"></i><span>Suppressor</span></div>",
      "css": ".ds-moldura{position:relative;background:#1B1C1F;border:1px solid #34373C;border-radius:3px;padding:16px;color:#EDEDEB;font-family:Barlow,sans-serif;font-size:20px;font-weight:600;min-height:80px}.ds-moldura i{position:absolute;width:14px;height:14px;border:0 solid #8E949B}.ds-moldura .a{top:-1px;left:-1px;border-top-width:2px;border-left-width:2px}.ds-moldura .b{top:-1px;right:-1px;border-top-width:2px;border-right-width:2px}.ds-moldura .c{bottom:-1px;left:-1px;border-bottom-width:2px;border-left-width:2px}.ds-moldura .d{bottom:-1px;right:-1px;border-bottom-width:2px;border-right-width:2px}"
    },
    {
      "name": "Casa de Bloco",
      "kind": "custom",
      "refersTo": "casa-bloco",
      "description": "Pedal na grade com fita de família de 4px; selecionado ganha contorno âmbar.",
      "html": "<div class=\"ds-grade\"><button class=\"ds-casa ds-casa-sel\"><span class=\"ds-arte\" style=\"--f:#E2C23A\"></span><span class=\"ds-fam\" style=\"--f:#E2C23A\"></span>SUP</button><button class=\"ds-casa\"><span class=\"ds-arte\" style=\"--f:#3BB7D6\"></span><span class=\"ds-fam\" style=\"--f:#3BB7D6\"></span>DGQ</button><button class=\"ds-casa\"><span class=\"ds-vazia\"></span></button></div>",
      "css": ".ds-grade{display:flex;gap:12px;align-items:flex-start;background:#1B1C1F;padding:12px;background-image:linear-gradient(#8E949B,#8E949B);background-size:100% 2px;background-position:0 46px;background-repeat:no-repeat}.ds-casa{width:84px;padding:4px;background:transparent;border:2px solid transparent;border-radius:6px;color:#EDEDEB;font-family:'Barlow Condensed',sans-serif;font-weight:600;font-size:14px;letter-spacing:.7px;display:flex;flex-direction:column;align-items:center;gap:2px;cursor:pointer;transition:background .15s,border-color .15s}.ds-casa:focus-visible{outline:2px solid #F0B429}.ds-casa-sel{background:#24262A;border-color:#F0B429}.ds-arte{width:62px;height:62px;border-radius:6px;background:var(--f);margin-bottom:2px}.ds-fam{width:100%;height:4px;background:var(--f)}.ds-vazia{width:18px;height:18px;margin:31px 0;border-radius:50%;background:#131416;border:2px solid #34373C}"
    },
    {
      "name": "Knob",
      "kind": "custom",
      "refersTo": "knob",
      "description": "Knob de 270°: trilho de filete, arco na cor da família, ponteiro de fita gaffer.",
      "html": "<div class=\"ds-knob\" tabindex=\"0\"><span class=\"ds-knob-nome\">THRESHOLD</span><svg viewBox=\"0 0 104 104\" width=\"104\" height=\"104\"><path d=\"M24.4 79.6 A39 39 0 1 1 79.6 79.6\" fill=\"none\" stroke=\"#34373C\" stroke-width=\"6\" stroke-linecap=\"round\"/><path d=\"M24.4 79.6 A39 39 0 0 1 24.4 24.4\" fill=\"none\" stroke=\"#E2C23A\" stroke-width=\"6\" stroke-linecap=\"round\"/><circle cx=\"52\" cy=\"52\" r=\"29\" fill=\"#24262A\" stroke=\"#8E949B\" stroke-width=\"1\"/><line x1=\"46.9\" y1=\"46.9\" x2=\"35.2\" y2=\"35.2\" stroke=\"#E8E1CD\" stroke-width=\"4.2\" stroke-linecap=\"round\"/></svg><span class=\"ds-knob-valor\">-52,0 dB</span></div>",
      "css": ".ds-knob{display:inline-flex;flex-direction:column;align-items:center;gap:4px;padding:8px;background:#1B1C1F;outline:none}.ds-knob-nome{font-family:'Barlow Condensed',sans-serif;font-weight:600;font-size:14px;letter-spacing:.7px;color:#A7ACB2}.ds-knob-valor{font-family:Barlow,sans-serif;font-weight:600;font-size:17px;color:#EDEDEB;font-variant-numeric:tabular-nums}.ds-knob:focus-visible circle{stroke:#F0B429;stroke-width:2}"
    },
    {
